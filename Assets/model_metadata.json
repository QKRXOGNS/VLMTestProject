{
  "model_type": "vision_language_model",
  "base_model": "LiquidAI/LFM2.5-VL-450M",
  "architecture": "LFM2.5-VL",
  "parameters": "450M",
  "max_seq_length": 512,
  "image_size": 448,
  "vocab_size": 32000,
  "input_schema": {
    "images": {
      "shape": [
        1,
        3,
        448,
        448
      ],
      "dtype": "float32",
      "description": "전처리된 RGB 이미지 (정규화됨)"
    },
    "input_ids": {
      "shape": [
        1,
        512
      ],
      "dtype": "int64",
      "description": "토큰화된 텍스트 입력 ID"
    },
    "attention_mask": {
      "shape": [
        1,
        512
      ],
      "dtype": "int64",
      "description": "어텐션 마스킹"
    }
  },
  "output_schema": {
    "logits": {
      "shape": [
        1,
        512,
        32000
      ],
      "dtype": "float32",
      "description": "다음 토큰 로짓"
    }
  },
  "preprocessing": {
    "image": {
      "resize": [
        448,
        448
      ],
      "normalize": {
        "mean": [
          0.481,
          0.458,
          0.408
        ],
        "std": [
          0.269,
          0.261,
          0.276
        ]
      },
      "format": "RGB",
      "value_range": [
        0,
        1
      ]
    },
    "text": {
      "chat_template": "mmtp",
      "add_generation_prompt": true
    }
  },
  "unity_integration": {
    "package": "com.unity.sentis",
    "min_version": "1.0.0",
    "supported_backends": [
      "CPUBackend",
      "CoreMLBackend",
      "CUDABackend"
    ],
    "recommended_backend": "CoreMLBackend",
    "notes": [
      "VLM 모델의 복잡성으로 인해 완전한 ONNX 변환은 어려울 수 있음",
      "대안: Python API 서버로 실행 후 Unity에서 HTTP 요청"
    ]
  }
}